[editor]
line_wrapping=true
line_break_column=72
auto_continue_multiline=true

[file_prefs]
final_new_line=true
ensure_convert_new_lines=false
strip_trailing_spaces=false
replace_tabs=false

[indentation]
indent_width=4
indent_type=1
indent_hard_tab_width=8
detect_indent=true
detect_indent_width=false
indent_mode=2

[project]
name=bus_antsirabe_api
base_path=/home/manohy/Projects/bus_antsirabe_api

[long line marker]
long_line_behaviour=1
long_line_column=72

[files]
current_page=1
