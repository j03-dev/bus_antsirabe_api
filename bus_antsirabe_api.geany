[VTE]
last_dir=/home/manohy

[prjorg]
expanded_paths=/home/manohy/Projects/bus_antsirabe_api;
source_patterns=*.c;*.C;*.cpp;*.cxx;*.c++;*.cc;*.m;
header_patterns=*.h;*.H;*.hpp;*.hxx;*.h++;*.hh;
